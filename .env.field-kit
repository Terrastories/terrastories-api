# Field Kit Environment Configuration
# Optimized for offline deployment via WiFi hotspot
# Designed for community data collection in remote areas

NODE_ENV=field-kit
PORT=3000
HOST=0.0.0.0
DATABASE_URL=./field-kit-data.db
JWT_SECRET=field-kit-deployment-secret-change-me
# V2 prelogin HMAC key (SPEC-V2 §7); replace the placeholder per installation.
AUTH_SERVER_SECRET=field-kit-prelogin-secret-change-me-in-production

# V2 Hono server. field-kit mode needs an https origin unless the trusted-LAN
# plain-HTTP exception is opted into (SPEC-V2 §7).
HONO_PORT=3001
HONO_PUBLIC_ORIGIN=https://your-field-kit.local
# HONO_ALLOW_PLAIN_HTTP=true
BOOTSTRAP_SECRET=field-kit-bootstrap-secret-change-me-per-installation

# Field Kit specific features (set by schema defaults)
OFFLINE_MODE=true
SYNC_ENABLED=true
CACHE_STRATEGY=aggressive
LOG_LEVEL=error
MEDIA_UPLOAD=true
ADMIN_INTERFACE=true

# Field Kit specific settings
# WIFI_HOTSPOT_NAME=Terrastories-FieldKit
# LOCAL_NETWORK_ONLY=true
# BACKUP_ENABLED=true
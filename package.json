{
  "name": "terrastories-api",
  "version": "1.0.0",
  "description": "TypeScript backend for Terrastories geostorytelling platform",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest",
    "test:coverage": "SKIP_TIMING_ASSERTIONS=true vitest run --coverage --exclude tests/production/performance.test.ts --reporter=dot --silent=true --maxWorkers=4",
    "test:ci:contracts": "bash tests/scripts/user_workflow.test.sh && vitest run tests/scripts --reporter=dot --silent=true --maxWorkers=4",
    "test:ci:core": "vitest run tests/config/ tests/db tests/helpers tests/integration tests/hono --reporter=dot --silent=true --maxWorkers=4",
    "test:ci:routes": "vitest run tests/routes --reporter=dot --silent=true --maxWorkers=4",
    "test:ci:services": "vitest run tests/repositories tests/services tests/shared tests/security tests/unit tests/app.test.ts tests/config.test.ts --reporter=dot --silent=true --maxWorkers=4",
    "test:ci:production": "vitest run tests/production tests/docker --reporter=dot --silent=true --maxWorkers=1",
    "test:ci:comparison": "vitest run tests/comparison --reporter=dot --silent=true --maxWorkers=4",
    "test:sovereignty": "vitest run tests/security/sovereignty-matrix.test.ts tests/security/inactive-principal.test.ts tests/security/sovereignty-audit-logging.test.ts tests/security/sovereignty-route-boundaries.test.ts tests/security/sovereignty-field-serialization.test.ts tests/security/sovereignty-story-audience.test.ts tests/security/sovereignty-stats-audience.test.ts tests/security/sovereignty-community-discoverability.test.ts tests/security/sovereignty-speaker-withdrawal.test.ts tests/security/sovereignty-administrative-sequences.test.ts tests/unit/administrative-policy.test.ts tests/services/administrative-service-guards.test.ts tests/security/field-kit-file-sovereignty.test.ts tests/routes/public-api.test.ts tests/routes/files.test.ts tests/shared/middleware/data-sovereignty.test.ts --reporter=dot --silent=true --maxWorkers=2",
    "test:ci": "node scripts/run-test-shards.mjs",
    "test:db:sqlite": "tsx scripts/test-db-backend.ts sqlite && tsx scripts/test-migration-metadata.ts",
    "test:db:postgres": "tsx scripts/test-db-backend.ts postgres && tsx scripts/test-postgres-migration-regressions.ts",
    "lint": "eslint . --max-warnings 0",
    "audit:baseline": "node scripts/check-audit-baseline.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "NODE_ENV=development tsx src/db/seed.ts",
    "prepare": "npx husky",
    "validate": "npm run validate:ci",
    "validate:ci": "npm run format:check && npm run type-check && npm run lint && npm run test:ci && npm run build",
    "compare:api": "node scripts/api-comparison.js",
    "test:compatibility": "vitest run tests/comparison --reporter=dot --silent=true --maxWorkers=4",
    "compatibility:report": "node scripts/api-comparison.js report --output api-comparison-report.html",
    "compatibility:full": "npm run test:compatibility && npm run compatibility:report",
    "dev:hono": "NODE_ENV=development tsx watch src/hono-server.ts",
    "start:hono": "node dist/hono-server.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/session": "^11.1.0",
    "@fastify/static": "^10.1.3",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@hono/node-server": "^2.1.7",
    "@types/bcrypt": "^6.0.0",
    "@types/pg": "^8.15.5",
    "argon2": "^0.44.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.2.0",
    "dotenv": "^17.2.1",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "fastify": "^5.12.1",
    "file-type": "^21.0.0",
    "hono": "^4.13.18",
    "mime-types": "^3.0.1",
    "pg": "^8.16.3",
    "postgres": "^3.4.7",
    "sharp": "^0.35.5",
    "uuid": "^11.1.0",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@eslint/js": "^9.34.0",
    "@types/argon2": "^0.15.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/form-data": "^2.2.1",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^24.3.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.34.0",
    "form-auto-content": "^3.2.1",
    "form-data": "^4.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5",
    "miniflare": "4.20260426.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  },
  "keywords": [
    "terrastories",
    "typescript",
    "fastify",
    "drizzle",
    "geostorytelling"
  ],
  "author": "Terrastories Team",
  "license": "MIT",
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "tests/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{json,md,mdx,yml,yaml,css,scss,html}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=9.0.0"
  },
  "engineStrict": false,
  "overrides": {
    "js-yaml": "^4.3.2",
    "@fastify/static": {
      "glob": "14.0.3"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.3"
    },
    "eslint": {
      "minimatch": "11.0.3"
    },
    "@eslint/config-array": {
      "minimatch": "11.0.3"
    },
    "@eslint/eslintrc": {
      "minimatch": "11.0.3"
    },
    "miniflare": {
      "undici": "^7.30.1",
      "sharp": "^0.35.5",
      "ws": "^8.21.0"
    }
  },
  "allowScripts": {
    "argon2@0.44.0": true,
    "bcrypt@6.0.0": true,
    "better-sqlite3@12.2.0": true,
    "esbuild@0.25.9": true,
    "sharp@0.35.5": true
  }
}

{
  // Production environment template for Workers Paid (docs/WORKERS-PAID-PROFILE.md
  // section 3, step 3; #295). Not active until the spec is amended and an owner
  // approves the Paid plan. Copy the `production` block under `env` in
  // `wrangler.jsonc`, replace every REPLACE-WITH-PROD-* placeholder, and deploy
  // with `npx wrangler deploy --env production`.
  //
  // Why `env.production` instead of top-level `limits`:
  //   `limits` is inheritable in Wrangler. Putting `limits` at the top level
  //   would also apply it to `env.staging`, which fails on a Free account.
  //   Bindings (`d1_databases`, `r2_buckets`), `vars`, and `triggers` are NOT
  //   inheritable and must be declared explicitly inside `env.production`.
  //
  // Verify before deploying:
  //   npx wrangler deploy --env production --dry-run
  //
  // Secrets (never `vars`; set with `npx wrangler secret put <NAME> --env production`):
  //   AUTH_SERVER_SECRET, BOOTSTRAP_SECRET, R2_ACCOUNT_ID,
  //   R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY; optional MAPBOX_ACCESS_TOKEN.
  //   ENVIRONMENT stays unset (production rules). ORPHAN_SWEEP_PAUSED is set
  //   only during a restore.
  "env": {
    "production": {
      "name": "REPLACE-WITH-PROD-WORKER-NAME",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "REPLACE-WITH-PROD-DB-NAME",
          "database_id": "REPLACE-WITH-PROD-D1-ID",
          "migrations_dir": "src/db/migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "REPLACE-WITH-PROD-MEDIA-BUCKET",
        },
        // Out-of-band erasure records (src/services/ERASURE-OPERATIONS.md):
        // dedicated bucket, never restored, rotated or copied with D1/MEDIA,
        // excluded from backups, no lifecycle expiration rule. Without it
        // erasure answers 503.
        {
          "binding": "ERASURE_RECORDS",
          "bucket_name": "REPLACE-WITH-PROD-ERASURE-BUCKET",
        },
      ],
      "vars": {
        "PUBLIC_ORIGIN": "https://REPLACE-WITH-PROD-ORIGIN",
        "CORS_ORIGINS": "",
        "R2_BUCKET_NAME": "REPLACE-WITH-PROD-MEDIA-BUCKET",
      },
      // src/worker.ts matches these exact strings: hourly sweep, minute
      // export expiry, and the separate minute erasure retry.
      "triggers": { "crons": ["0 * * * *", "* * * * *", "*/1 * * * *"] },
      // Workers Paid only (docs/WORKERS-PAID-PROFILE.md). Caps cost of a runaway
      // invocation; start at 30000 ms (the Paid default) and tighten to about 5x
      // the measured p99 of the slowest route. Leave limits.subrequests unset
      // (default 10,000).
      "limits": { "cpu_ms": 30000 },
      "observability": { "enabled": false, "traces": { "enabled": false } },
    },
  },
}

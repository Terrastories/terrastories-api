{
  "name": "terrastories-v2-template",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-12",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "replace-with-your-database",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "src/db/migrations",
    },
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "replace-with-your-bucket" },
  ],
  "vars": {
    "PUBLIC_ORIGIN": "https://example.org",
    "CORS_ORIGINS": "",
    // Direct multipart upload (#286): the media bucket's name (not a secret).
    // Also set the secrets R2_ACCOUNT_ID, R2_ACCESS_KEY_ID and
    // R2_SECRET_ACCESS_KEY (an R2 API token scoped to this bucket) with
    // `wrangler secret put`; without all four /v2/media/uploads answers 501.
    // The bucket needs CORS for the frontend origin: PUT, header
    // exposed header ETag (SPEC-V2 section 6.7).
    "R2_BUCKET_NAME": "replace-with-your-bucket",
    // Optional Workers plan selector (docs/WORKERS-PAID-PROFILE.md section 3 step 6):
    // WORKERS_PLAN defaults to "free" when unset; set to "paid" only in an
    // environment deployed to a Workers Paid account after the SPEC-V2
    // section 5 and section 7 amendments are approved.
  },
  // Secrets are never `vars`. Set the prelogin HMAC key with:
  //   npx wrangler secret put AUTH_SERVER_SECRET --env staging
  // The runtime gate refuses production serves without it.
  // Hourly sweep (§6.7 orphan bytes). Throughput: ~1,200 keys/run x 24 runs/day
  // ≈ 28,800 keys/day, cycling a 100k-key keyspace in < 4 days — well inside the
  // 30-day bound; ~34 deletes/run (~800/day) for all-orphan backlogs.
  // Export artifacts have a 15-minute TTL and a one-minute cleanup grace.
  // Separate invocation budgets: minute export expiry and minute erasure.
  "triggers": { "crons": ["0 * * * *", "* * * * *", "*/1 * * * *"] },
  "observability": { "enabled": false, "traces": { "enabled": false } },
  // Staging environment template (scripts/staging/provision.sh, docs/CUTOVER-RUNBOOK.md).
  // Placeholders only: replace the database_id with the id printed by
  // `wrangler d1 create terrastories-staging-db` and PUBLIC_ORIGIN with the
  // deployed workers.dev URL. Every staging resource name starts with
  // "terrastories-staging-"; provision.sh refuses anything else. Bindings and
  // vars are NOT inherited from the top level, so they are repeated here.
  // Workers Free allows 5 cron triggers per account: staging needs all 3 the
  // Worker dispatches, so staging and production (3) cannot both hold their
  // crons at once; see docs/CUTOVER-RUNBOOK.md section 6.
  "env": {
    "staging": {
      "name": "terrastories-staging-api",
      "workers_dev": true,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "terrastories-staging-db",
          "database_id": "REPLACE-WITH-STAGING-D1-ID",
          "migrations_dir": "src/db/migrations",
        },
      ],
      "r2_buckets": [
        { "binding": "MEDIA", "bucket_name": "terrastories-staging-media" },
        // Out-of-band erasure records (src/services/ERASURE-OPERATIONS.md):
        // dedicated bucket, never restored, rotated or copied with D1/MEDIA,
        // excluded from backups, no lifecycle expiration rule. Without it
        // erasure answers 503.
        {
          "binding": "ERASURE_RECORDS",
          "bucket_name": "terrastories-staging-erasure-records",
        },
      ],
      "vars": {
        "PUBLIC_ORIGIN": "https://terrastories-staging-api.REPLACE-WITH-SUBDOMAIN.workers.dev",
        "CORS_ORIGINS": "",
        "R2_BUCKET_NAME": "terrastories-staging-media",
      },
      // src/worker.ts matches these exact strings: hourly sweep, minute
      // export expiry, and the separate minute erasure retry.
      "triggers": { "crons": ["0 * * * *", "* * * * *", "*/1 * * * *"] },
      // Secrets (wrangler secret put ... --env staging, never vars):
      // AUTH_SERVER_SECRET, BOOTSTRAP_SECRET, R2_ACCOUNT_ID,
      // R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY; optional MAPBOX_ACCESS_TOKEN.
      // ENVIRONMENT stays unset (production rules). ORPHAN_SWEEP_PAUSED is set
      // only during a restore.
      "observability": { "enabled": false, "traces": { "enabled": false } },
    },
  },
}
